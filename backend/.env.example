# ============================================================================
# MONOLOOP backend (FastAPI) - copy to backend/.env and fill in.
# NEVER commit backend/.env.
# ============================================================================

ENVIRONMENT=development

# Supabase -> Connect -> Direct -> "Session pooler" URI (port 5432), with your DATABASE password.
# Leave empty to run on the built-in in-memory demo data.
DATABASE_URL=
# auto = Postgres when DATABASE_URL is set, else Supabase REST when the two SUPABASE_ values below
#        are set, else in-memory demo data
# memory | postgres | supabase
DATA_BACKEND=auto

# No database password? Use Supabase REST instead (Project Settings -> API Keys).
# The service-role key bypasses row-level security: keep it here only, never in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DB_POOL_SIZE=10

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_WRITES_PER_MINUTE=60

# demo = organization switcher (X-Organization-Id header); jwt = Supabase access tokens.
AUTH_MODE=demo
# jwt needs migration 00009 and a super admin: python -m app.scripts.create_admin (see docs/AUTH.md).
# Offline only (no Supabase): create this admin at startup in the in-process login provider.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# AI material extraction (gemini | openai)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest
# Voice input fallback for browsers without in-browser speech recognition (Firefox).
# Empty = reuse AI_MODEL (Gemini) / gpt-4o-mini-transcribe (OpenAI).
AI_TRANSCRIBE_MODEL=
MAX_AUDIO_BYTES=1500000
# Hosted models often answer 503 "overloaded": retry with backoff inside one overall budget
# (keep it under the frontend's 30 s timeout). If the provider stays down, the offline parser fills the form.
AI_TIMEOUT_SECONDS=10
AI_MAX_ATTEMPTS=3
AI_TOTAL_TIMEOUT_SECONDS=24

# Payments: SSLCommerz (developer.sslcommerz.com). "none" = exchanges complete without payment.
# Needs migration 00007_payments.sql. Sandbox test store: testbox / qwerty.
PAYMENT_PROVIDER=none
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Where the browser reaches this API (gateway returns here) and the frontend.
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
