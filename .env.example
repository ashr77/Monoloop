# ============================================================================
# MONOLOOP - Environment Variables Configuration
# TSUNAGU Hackathon 2026
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or secret keys to Git.
# ============================================================================

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Hosted AI LLM Configuration (For Natural-Language Material Extraction)
# Supports Gemini API or OpenAI API
AI_PROVIDER=gemini
AI_API_KEY=your-llm-api-key-here
AI_MODEL=gemini-1.5-flash

# Base App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
